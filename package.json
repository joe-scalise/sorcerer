{
  "name": "sorcerer",
  "version": "1.8.2",
  "description": "Multi-session desktop workbench for orchestrating AI coding agents in isolated Git worktrees.",
  "homepage": "https://sorcerer.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-scalise/sorcerer.git"
  },
  "bugs": {
    "url": "https://github.com/joe-scalise/sorcerer/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "verify": "npm run typecheck && npm run build",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:dist": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "rebuild": "npx @electron/rebuild -f -w node-pty",
    "test": "vitest run",
    "release:check": "node scripts/validate-release.cjs",
    "smoke:native": "node scripts/smoke-native.cjs"
  },
  "build": {
    "appId": "com.sorcerer.app",
    "productName": "Sorcerer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false,
    "afterSign": "./scripts/notarize-macos.js",
    "artifactName": "Sorcerer-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "joe-scalise",
      "repo": "sorcerer",
      "channel": "latest",
      "releaseType": "draft"
    }
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "electron",
    "git-worktrees",
    "orchestration"
  ],
  "author": "Joe Scalise",
  "license": "Apache-2.0",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.14",
    "electron-updater": "6.8.9",
    "electron-vite": "^5.0.0",
    "marked": "^17.0.5",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-git": "^3.30.0",
    "sql.js": "^1.13.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^42.11.4",
    "electron-builder": "^26.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "yaml": "2.9.1"
  }
}
