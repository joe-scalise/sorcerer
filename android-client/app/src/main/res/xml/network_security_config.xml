<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is intentional for private LAN/VPN hosts because their addresses are
  selected at runtime. TLS still uses only the system trust store; certificate
  errors are never bypassed. See README.md for the supported threat model.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
